# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
dist/
build/
.claude/

# DVC - ignore actual data, but allow .dvc pointer files
/data/**
!/data/**/*.dvc
!/data/**/
# Tiny reproducible split manifest (regenerated by ai.training.splits) — committed
# so the test slice is frozen across machines/CI without depending on DVC pull.
!/data/processed/audit_v2_corrected/test_holdout.csv
/ai/models/checkpoints/**
!/ai/models/checkpoints/**/
!/ai/models/checkpoints/**/*.dvc
/experiments/results/**
!/experiments/results/**/
!/experiments/results/*.json
mlflow/mlruns/

/context/**

# Environment
.env
*.env

# Jupyter
.ipynb_checkpoints/
notebooks/**/*.html

# Sandbox-generated visualizations (regenerable from scripts + DVC-tracked checkpoints)
notebooks/sandbox/**/viz_*/

# MLflow
mlflow/mlruns/

# Local run logs
/logs/

# Node (frontend)
front/node_modules/
front/.next/
front/dist/

# Reference PDFs (large binaries — share via Drive/Notion instead)
docs/references/*.pdf

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier
